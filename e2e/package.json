{
  "name": "stockaccount-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:vue": "cross-env E2E_UI=vue playwright test --project=vue --project=vue-mobile",
    "test:nuxt": "cross-env E2E_UI=nuxt playwright test --project=nuxt --project=nuxt-mobile",
    "test:docker": "cross-env E2E_EXTERNAL=1 playwright test --grep @smoke",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cross-env": "^10.1.0"
  }
}
