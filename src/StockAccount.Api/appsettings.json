{
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=StockAccountDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=1000,syncTimeout=1000,asyncTimeout=1000"
  },
  "Jwt": {
    "Issuer": "StockAccount",
    "Audience": "StockAccount.Clients",
    "Key": "DEV-ONLY-change-me-0123456789-abcdefghijklmnop",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshCookieName": "sa_refresh",
    "RefreshReuseGraceSeconds": 30
  },
  "Cache": { "Enabled": true, "UseRedis": true, "EntityTtlMinutes": 10, "ListTtlMinutes": 5, "CircuitBreakSeconds": 30 },
  "Inventory": { "AllowNegativeStock": false },
  "Reconciliation": { "Enabled": true, "IntervalMinutes": 5, "InitialDelaySeconds": 30, "AutoFix": false },
  "Database": { "MigrateOnStartup": true, "Seed": true },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ] },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] [U:{UserId}] [C:{CompanyId}] [{MachineName}/{ThreadId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
