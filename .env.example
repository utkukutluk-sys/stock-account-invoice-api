# Copy to .env (git-ignored) — better: run ./scripts/deploy/new-secrets.ps1, which writes .env with strong random values.
# The values below are PUBLIC PLACEHOLDERS. The API refuses a JWT_KEY containing "change-me" in Production and only
# tolerates it (with a loud warning) in the local "Docker" demo environment. docker compose fails if a value is missing.
MSSQL_SA_PASSWORD=StockAccount!2026
JWT_KEY=docker-change-me-0123456789-abcdefghijklmnopqrst
# Least-privilege runtime login used by the API (db-migrate creates it with sa; the API never uses sa).
APP_DB_USER=stockaccount_app
APP_DB_PASSWORD=App!Change-Me-2026
# Image tag used by docker compose (deploy.ps1 sets it per release).
APP_VERSION=local

# ---------------------------------------------------------------------------------------------------------------------
# PRODUCTION on a VPS (docker-compose.prod.yml, scripts/deploy/deploy.ps1 -Production). See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------------------------------------------------
# Public host name (DNS A record -> the server) and the e-mail Lets Encrypt uses for expiry notices.
DOMAIN=
ACME_EMAIL=
# First Admin, created ONCE by the db-migrate step when no Admin exists (the password is generated by
# scripts/deploy/new-secrets.ps1 -AdminEmail you@example.com). After the first login change the password in the UI and
# delete BOOTSTRAP_ADMIN_PASSWORD from .env. Production refuses to start without an Admin and without these two values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional first company (name + 10/11 digit tax number); only used together with the first admin creation.
BOOTSTRAP_COMPANY_NAME=
BOOTSTRAP_COMPANY_TAX_NUMBER=
# Optional tuning (defaults shown): production rate limits per 60 s, SQL Server edition.
#RATE_LIMIT_GLOBAL_PERMIT=300
#RATE_LIMIT_AUTH_PERMIT=10
#MSSQL_PID=Express
# Local production test only (never on the server): LOCAL_TLS=internal uses Caddy's own CA instead of Lets Encrypt,
# HTTP_PORT/HTTPS_PORT move Caddy off 80/443, NET_PREFIX moves the compose network (default 172.30.0).
#LOCAL_TLS=internal
#HTTP_PORT=8080
#HTTPS_PORT=8443
#NET_PREFIX=172.30.0

# ---------------------------------------------------------------------------------------------------------------------
# OFF-SITE BACKUP (docs/DEPLOYMENT.md "Sunucu dışı yedek"): every successful backup is also uploaded to an S3-compatible bucket
# (rclone in a container). Disabled by default. Recommended: Cloudflare R2 (alternative: Backblaze B2). Use a PRIVATE bucket and an
# access token limited to that bucket (R2: "Object Read & Write", bucket-scoped).
# ---------------------------------------------------------------------------------------------------------------------
OFFSITE_ENABLED=false
#OFFSITE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   # Backblaze B2: https://s3.<region>.backblazeb2.com ; AWS S3: leave empty
#OFFSITE_S3_REGION=auto                                              # B2: the region of the endpoint, AWS: e.g. eu-central-1
#OFFSITE_S3_BUCKET=stockaccount-backups
#OFFSITE_S3_ACCESS_KEY=
#OFFSITE_S3_SECRET_KEY=
#OFFSITE_PREFIX=prod                  # folder inside the bucket (default stockaccount; staging uses stockaccount-staging)
#OFFSITE_RETENTION_DAYS=30            # bucket copies older than this are deleted (0 = never) ...
#OFFSITE_MIN_KEEP=3                   # ... but the newest N are always kept

# ---------------------------------------------------------------------------------------------------------------------
# Environments (docs/DEPLOYMENT.md "Ortamlar"): dev = this file (.env), staging = .env.staging (scripts/deploy/new-secrets.ps1
# -Environment staging, git-ignored), prod = .env on the server. Backups never share a folder: dev ./backups, staging
# ./backups/staging, prod ./backups/prod (BACKUP_DIR below overrides it; set it also when you run the scheduled backup sidecar).
# ---------------------------------------------------------------------------------------------------------------------
#BACKUP_DIR=./backups/prod
# staging only (.env.staging): bind address of Caddy's 8080/8443 (default 127.0.0.1)
#STAGING_BIND=127.0.0.1
