# Copy to .env (git-ignored) — better: run ./scripts/deploy/new-secrets.ps1, which writes .env with strong random values.
# The values below are PUBLIC PLACEHOLDERS. The API refuses a JWT_KEY containing "change-me" in Production and only
# tolerates it (with a loud warning) in the local "Docker" demo environment. docker compose fails if a value is missing.
MSSQL_SA_PASSWORD=StockAccount!2026
JWT_KEY=docker-change-me-0123456789-abcdefghijklmnopqrst
# Image tag used by docker compose (deploy.ps1 sets it per release).
APP_VERSION=local
